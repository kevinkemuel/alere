# ─────────────────────────────────────────────────────────────
# Configuración del catálogo (copia este archivo a .env / .env.local
# y rellena los valores reales; los .env* NO se commitean).
# ─────────────────────────────────────────────────────────────

# OPCIÓN A — Conexión directa a Postgres (Prisma).
# Úsala en Vercel / local / VPS, donde la salida a la base NO está bloqueada.
DATABASE_URL="postgresql://usuario:password@host:6543/postgres?pgbouncer=true&prepare_threshold=0"

# OPCIÓN B — API REST de Supabase (HTTPS / puerto 443).
# Úsala en hostings que bloquean los puertos de base de datos (p. ej. cPanel).
# Si estas dos están definidas, tienen PRIORIDAD sobre DATABASE_URL.
# La service key es SOLO para el servidor: nunca uses el prefijo NEXT_PUBLIC_.
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_KEY="<service_role key del panel: Project Settings → API>"

# Opcional: id/token/slug del catálogo del negocio en Komercio.
# NEXT_PUBLIC_CATALOGO_ID="alere"

# Opcional: fuerza los datos de muestra aunque haya base configurada.
# NEXT_PUBLIC_USE_MOCK="true"
